APP_NAME=YouTube Shorts Automation API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Use localhost for commands run on the host. Docker Compose overrides this to postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=shorts
POSTGRES_USER=shorts
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_ROOT=storage/videos
MAX_UPLOAD_SIZE_MB=1024
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PEXELS_API_KEY=

# Publishing and YouTube OAuth
PUBLISHING_PROVIDER=local
PUBLISHING_EXECUTION_LEASE_SECONDS=900
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
OAUTH_STATE_TTL_SECONDS=600

# Credential encryption
CREDENTIAL_ENCRYPTION_KEY=
